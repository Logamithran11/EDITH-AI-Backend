# NVIDIA AI Catalog API Configuration
# Get your API key from: https://build.nvidia.com
# Keep this secret! Never commit your real API key to git.
NVIDIA_API_KEY=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

# Selected Model from NVIDIA API Catalog:
# - nvidia/nemotron-3.5-lightning-30b-a3b (Fast, reasoning-optimized, default)
# - nvidia/nemotron-3.5-bolt-e4b (Lightweight, ultra-fast)
# - openai/gpt-oss-20b
# - qwen/qwen3-next-80b-a3b-instruct
# - meta/llama-3.1-70b-instruct
# - nvidia/llama-3.1-nemotron-70b-instruct
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Base URL for NVIDIA NIM Inference Catalog
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Server Settings
# 0.0.0.0 binds to all network interfaces, allowing physical Android phones on the same Wi-Fi to connect
HOST=0.0.0.0
PORT=8000
TIMEOUT_SECONDS=30.0
MAX_RETRIES=2
